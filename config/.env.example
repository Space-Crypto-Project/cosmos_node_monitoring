TELEGRAM_ADMIN="<YOUR_TELEGRAM_USER_ID>"
TELEGRAM_TOKEN="<YOUR_TELEGRAM_BOT_TOKEN>"

# Telegram notification policy. `all` selects every active alert rule.
# Defaults preserve the historical delivery behavior.
TELEGRAM_ALERTS=all
TELEGRAM_GROUP_WAIT=0s
TELEGRAM_GROUP_INTERVAL=5m
TELEGRAM_REPEAT_INTERVAL=1h

# Optional SMTP e-mail notifications. Keep disabled until every required value is set.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=
EMAIL_SMTP_TO=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_REQUIRE_TLS=true

# E-mail notification policy. Use active alert names separated by commas.
# By default, mail is limited to node-down and validator-jail alerts.
EMAIL_ALERTS=InstanceDown,IsJailed,ValidatorIsJailed
EMAIL_GROUP_WAIT=0s
EMAIL_GROUP_INTERVAL=5m
EMAIL_REPEAT_INTERVAL=24h
